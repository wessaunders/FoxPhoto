{
    "name": "foxphoto",
    "version": "1.0.0",
    "description": "A cross-platform desktop image viewer.",
    "main": "electron/main.js",
    "author": "Wes Saunders",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "vite",
        "electron-dev": "concurrently \"npm run dev\" \"cross-env NODE_ENV=development electron --inspect .\"",
        "build": "vite build",
        "start": "electron .",
        "electron": "electron .",
        "electron-pack": "electron-builder --dir",
        "electron-dist": "electron-builder"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@mantine/core": "^8.3.1",
        "@mantine/hooks": "^8.3.1",
        "@tabler/icons-react": "^3.35.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "cross-env": "^10.0.0",
        "exifr": "^7.1.3",
        "image-size": "^2.0.2",
        "pdfjs-dist": "^5.4.149",
        "piexifjs": "^1.0.6",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-virtuoso": "^4.14.0",
        "zustand": "^5.0.8"
        
    },
    "devDependencies": {
        "@types/pdfjs-dist": "^2.10.377",
        "@vitejs/plugin-react": "^5.0.3",
        "concurrently": "^9.2.1",
        "electron": "^38.1.2",
        "electron-builder": "^26.0.12",
        "vite": "^7.1.6"
    },
    "build": {
        "appId": "com.telekineticlou.foxphoto",
        "files": [
            "dist/**/*",
            "main.js",
            "preload.js"
        ],
        "directories": {
            "buildResources": "assets"
        }
    }
}
